	{
		"name": "update_template",
		"description": "Update one template by id: rename it, change its optional subject or rewrite its body. Omitted fields keep their stored value; an explicit null subject clears it.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"mailboxId": {
					"type": "string"
				},
				"templateId": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"subject": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"body": {
					"type": "string"
				}
			},
			"required": [
				"mailboxId",
				"templateId"
			]
		},
		"annotations": {
			"readOnlyHint": false,
			"destructiveHint": false,
			"openWorldHint": false
		}
	}
