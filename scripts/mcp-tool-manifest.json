	{
		"name": "update_rule",
		"description": "Update a rule: rename, reorder, change its conditions or actions, enable or pause it. Omitted fields keep their stored value. Rules edited here cannot send mail.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"mailboxId": {
					"type": "string"
				},
				"ruleId": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"match": {
					"type": "object",
					"properties": {
						"mode": {
							"default": "all",
							"type": "string",
							"enum": [
								"all",
								"any"
							]
						},
						"conditions": {
							"type": "object",
							"properties": {
								"from_contains": {
									"type": "string"
								},
								"to_contains": {
									"type": "string"
								},
								"subject_contains": {
									"type": "string"
								},
								"body_contains": {
									"type": "string"
								},
								"has_attachment": {
									"type": "boolean"
								},
								"category_equals": {
									"type": "string"
								}
							}
						}
					},
					"required": [
						"conditions"
					]
				},
				"actions": {
					"type": "object",
					"properties": {
						"move_to_folder": {
							"type": "string"
						},
						"set_category": {
							"type": "string"
						},
						"mark_read": {
							"type": "boolean"
						},
						"mark_unread": {
							"type": "boolean"
						},
						"star": {
							"type": "boolean"
						},
						"unstar": {
							"type": "boolean"
						},
						"discard": {
							"type": "boolean"
						},
						"forward_to": {
							"type": "string"
						},
						"auto_reply_text": {
							"type": "string"
						}
					}
				},
				"enabled": {
					"type": "boolean"
				},
				"priority": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"mailboxId",
				"ruleId"
			]
		},
		"annotations": {
			"readOnlyHint": false,
			"destructiveHint": false,
			"openWorldHint": false
		}
	},
