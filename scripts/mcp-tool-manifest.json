[
	{
		"name": "apply_rule",
		"description": "Retroactively apply a stored rule's folder, category, read and star actions to existing mail, one bounded batch per call (loop while remaining > 0). Strictly local: it never sends, never deletes and never records a rule firing.",
		"inputSchema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"mailboxId": {
					"type": "string"
				},
				"ruleId": {
					"type": "string"
				},
				"limit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 90
				}
			},
			"required": [
				"mailboxId",
				"ruleId"
			]
		},
		"annotations": {
			"readOnlyHint": false,
			"destructiveHint": false,
			"openWorldHint": false
		}
	},
