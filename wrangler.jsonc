{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentic-inbox",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true,
		"redact_query_string": false
	},
	// Daily Trash retention sweep at 03:00 UTC; the handler lives in
	// workers/app.ts and the sweep in workers/lib/trash-retention.ts.
	"triggers": {
		"crons": ["0 3 * * *"]
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Production deploys must also define POLICY_AUD and TEAM_DOMAIN.
		// TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
		// The worker now fails closed outside local development if Access is not configured.
		"DOMAINS": "seanbehan.ca, codebam.ca",
		"EMAIL_ADDRESSES": [],
		// Optional catch-all overrides. Unset derives catch-all@<domain> for
		// every DOMAINS entry (and creates it on first use).
		// "CATCH_ALL_MAILBOXES": "catch-all@seanbehan.ca, catch-all@codebam.ca",
		// "CATCH_ALL_MAILBOX": "all@seanbehan.ca",
		"name": "EMAIL_ADDRESSES"
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-inbox",
			"preview_bucket_name": "agentic-inbox"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		}
	],
	"routes": [
		{
			"pattern": "email.codebam.ca",
			"zone_name": "codebam.ca",
			"custom_domain": true
		}
	]
}